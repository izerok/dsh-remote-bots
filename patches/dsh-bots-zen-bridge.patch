   else if (ctx.webServer) mountRoutes({ webServer: ctx.webServer, effect: (fn) => ctx.effect(fn) });
 
+  // dsh-remote-bots: zen-remote Plugin Bridge declaration (optional).
+  // No zen-remote installed -> ctx.inject(['zenRemote']) never fires, so this
+  // is a no-op and Bots behaves exactly as upstream. With dsh-zen-remote
+  // >= 2.1 installed on BOTH ends, the Bots panel (/__dsh_bots/*) is forwarded
+  // to the host instead of falling back to the client machine's empty data.
+  // Scope is 'server' because the panel is whole-machine data (teams, board,
+  // usage, settings), not one session: the host owner must explicitly enable
+  // it per plugin in zen-remote Settings -> Plugin Bridge (default OFF).
+  // maxBody 41943040 (40 MiB) covers Bots' own limits: postJson default
+  // MAX_BODY 4 MiB, and the images route limit MAX_IMAGE_UPLOAD 40 MiB.
+  // rewriteIds { fields: ['sessionId'] } (zen-remote 2.4+, PB-25a): the
+  // { fields } form is the value deep-scan PLUS a position rewrite for
+  // newly-created ids at the declared paths. POST send/open and the ticket
+  // routes answer a top-level `sessionId` the panel then feeds to
+  // env.openSession(); without this the host's real id reaches the remote
+  // browser and "open conversation" fails (the id is unknown on the client).
+  // Known limits: object KEYS are never rewritten (state.sessionMap keys
+  // stay real), and ids nested in arrays (bots[].sessionId in teams/hire)
+  // are only rewritten when already in the request/known inventory — a
+  // newly hired bot's home id is neither, so it stays real.
+  if (typeof ctx.inject === 'function') ctx.inject(['zenRemote'], (scope) => {
+    const bridge = scope.zenRemote;
+    if (!bridge || typeof bridge.bridge !== 'function') return;
+    const declaration = {
+      plugin: '@kadaliao/dsh-bots',
+      version: '0.17.2-zen.2',
+      routes: [
+        { path: '/__dsh_bots', prefix: true, scope: 'server', methods: ['GET', 'POST'], maxBody: 41943040, rewriteIds: { fields: ['sessionId'] } },
+      ],
+    };
+    const dispose = bridge.bridge(declaration);
+    ctx.effect(() => dispose, 'bots: zen-remote bridge declaration');
+  });
+
